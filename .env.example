# Copia este archivo como .env y ajusta los valores.
PORT=3000
# NODE_ENV=production

# Secreto para firmar la cookie de sesión (obligatorio en producción).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Motor de base de datos: sqlite (sin instalación) o mysql (MySQL 8 / MariaDB 10.5+)
DB_CLIENT=sqlite
# SQLITE_FILE=./data/mantenimiento.db

# Solo si DB_CLIENT=mysql (la base de datos debe existir: CREATE DATABASE mantenimiento CHARACTER SET utf8mb4;)
DB_HOST=localhost
DB_PORT=3306
DB_USER=mantenimiento
DB_PASSWORD=
DB_NAME=mantenimiento

# Cuenta de administrador creada al inicializar la BD
ADMIN_EMAIL=admin@mantenimiento.local
ADMIN_PASSWORD=admin123

# Cargar datos de ejemplo la primera vez que se crea la BD (true/false)
SEED_DEMO=true

# Si en producción se sirve por HTTP (sin HTTPS) dentro de la intranet, pon false
# COOKIE_SECURE=false
